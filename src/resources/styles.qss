/* Главный контейнер панели — наследует цвет фона системы, меняем только рамку */
QFrame#FilterPanelFrame { 
    border: 1px solid rgba(128, 128, 128, 0.3); /* Полупрозрачная рамка */
    border-radius: 6px; 
}

/* Поля ввода текста и чисел */
QLineEdit, QDoubleSpinBox, QComboBox {
    border: 1px solid rgba(128, 128, 128, 0.5);
    border-radius: 4px;
    padding: 4px;
    /* Фоны и цвета текста УДАЛЕНЫ — они подтягиваются из системы автоматически */
}

/* Подсветка активных фильтров — тут мы принудительно подсвечиваем поле */
QLineEdit[active="true"], QDoubleSpinBox[active="true"] { 
    border: 1px solid #0078D4; 
    background-color: rgba(0, 120, 212, 0.15); /* Полупрозрачный синий (работает и на темном, и на светлом) */
}

/* Базовый стиль кнопок */
QPushButton {
    padding: 5px 12px;
    border: 1px solid rgba(128, 128, 128, 0.5);
    border-radius: 4px;
    font-weight: 500;
}

/* Кнопка Обновить данные */
QPushButton#RefreshBtn {
    font-weight: bold;
}

/* Кнопка Применить (Синяя акцентная — она обычно остается синей в любой теме) */
QPushButton#ApplyBtn {
    background-color: #0078D4;
    color: #FFFFFF; /* Белый текст */
    border: none;
}

QPushButton#ApplyBtn:hover {
    background-color: #106EBE;
}